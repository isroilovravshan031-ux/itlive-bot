# ITLive Telegram Bot konfiguratsiyasi
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Asosiy adminlarning Telegram ID raqamlari (vergul bilan ajratilgan, masalan: 12345678,87654321)
ADMINS=123456789

# Ma'lumotlar bazasi fayli
DATABASE_PATH=data/itlive_bot.db

# Railway: public HTTPS domain (Networking -> Generate Domain)
APP_URL=https://YOUR-SERVICE.up.railway.app
BOT_USERNAME=YOUR_BOT_USERNAME
# One process runs the API and polling bot. Disable only for local UI/API tests.
RUN_BOT=true
# On Railway use /data/itlive_bot.db and attach a persistent volume at /data.
UPLOAD_DIR=data/uploads
